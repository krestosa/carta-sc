{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": ".build/tooling",
    "noEmitOnError": true
  },
  "include": [
    "scripts/**/*.ts",
    "lab/pages/**/*.ts",
    "lab/handoff/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".build",
    ".generated"
  ]
}
