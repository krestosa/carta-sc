{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Component-specific DTCG 2025.10 tokens for values that are not global primitives.",
  "component": {
    "color": {
      "$type": "color",
      "black07": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.07, "hex": "#000000" } },
      "black09": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.09, "hex": "#000000" } },
      "black16": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.16, "hex": "#000000" } },
      "white12": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.12, "hex": "#ffffff" } },
      "white22": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.22, "hex": "#ffffff" } },
      "white86": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.86, "hex": "#ffffff" } },
      "white98": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.98, "hex": "#ffffff" } },
      "darkAction": { "$value": { "colorSpace": "srgb", "components": [0.8471, 0.8471, 0.8275], "hex": "#d8d8d3" } },
      "darkClose": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "alpha": 0.88, "hex": "#0a0a0a" } },
      "darkCloseHover": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.0784, 0.0784], "alpha": 0.98, "hex": "#141414" } },
      "imagePreloaderLight": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8902, 0.8863], "hex": "#e3e3e2" } },
      "imagePreloaderDark": { "$value": { "colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1490], "hex": "#292926" } }
    },
    "dimension": {
      "$type": "dimension",
      "fontTenThreeQuarter": { "$value": { "value": 10.75, "unit": "px" } },
      "themeMenuWidth": { "$value": { "value": 176, "unit": "px" } },
      "themeMenuWidthMobile": { "$value": { "value": 182, "unit": "px" } },
      "themeOptionHeight": { "$value": { "value": 36, "unit": "px" } },
      "trackingThemeOption": { "$value": { "value": -0.06, "unit": "px" } },
      "modalOpenOffset": { "$value": { "value": 20, "unit": "px" } },
      "modalCloseOffset": { "$value": { "value": -10, "unit": "px" } }
    },
    "number": {
      "$type": "number",
      "scaleMenuClosed": { "$value": 0.8 },
      "scaleButtonPressed": { "$value": 0.98 },
      "scaleClosePressed": { "$value": 0.9 },
      "scaleMarkIdle": { "$value": 0.78 },
      "scaleMoon": { "$value": 1.3 },
      "strokeThemeRing": { "$value": 1.55 },
      "strokeThemeRay": { "$value": 1.65 },
      "strokeOptionRing": { "$value": 1.35 },
      "strokeOptionRay": { "$value": 1.25 },
      "strokeClose": { "$value": 1.6 }
    },
    "duration": {
      "$type": "duration",
      "searchReveal": { "$value": { "value": 220, "unit": "ms" } },
      "modalOpen": { "$value": { "value": 220, "unit": "ms" } },
      "modalClose": { "$value": { "value": 150, "unit": "ms" } },
      "imagePreloaderCycle": { "$value": { "value": 1500, "unit": "ms" } },
      "imagePreloaderDelay": { "$value": { "value": 80, "unit": "ms" } }
    },
    "shadow": {
      "$type": "shadow",
      "themeMenu": {
        "$value": {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.09, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 12, "unit": "px" },
          "blur": { "value": 28, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      }
    }
  }
}
