{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canonical SushiClub design-token document. DTCG 2025.10 is the source of truth; generated platform artifacts must derive from this document.",
  "color": {
    "palette": {
      "$type": "color",
      "ink": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "hex": "#0a0a0a" } },
      "heading": { "$value": { "colorSpace": "srgb", "components": [0.1882, 0.1882, 0.1882], "hex": "#303030" } },
      "copy": { "$value": { "colorSpace": "srgb", "components": [0.3725, 0.3725, 0.3725], "hex": "#5f5f5f" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.4627, 0.4627, 0.4627], "hex": "#767676" } },
      "trait": { "$value": { "colorSpace": "srgb", "components": [0.5961, 0.5961, 0.5961], "hex": "#989898" } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9608], "hex": "#f5f5f5" } },
      "surfaceTransparent": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9608], "alpha": 0, "hex": "#f5f5f5" } },
      "surfaceRaised": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9843, 0.9804], "hex": "#fbfbfa" } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8902, 0.8706], "hex": "#e3e3de" } },
      "borderStrong": { "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8196, 0.7961], "hex": "#d1d1cb" } },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "darkInk": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9529, 0.9412], "hex": "#f3f3f0" } },
      "darkCopy": { "$value": { "colorSpace": "srgb", "components": [0.7843, 0.7843, 0.7608], "hex": "#c8c8c2" } },
      "darkMuted": { "$value": { "colorSpace": "srgb", "components": [0.6118, 0.6118, 0.5843], "hex": "#9c9c95" } },
      "darkTrait": { "$value": { "colorSpace": "srgb", "components": [0.4353, 0.4353, 0.4353], "hex": "#6f6f6f" } },
      "darkSurfaceRaised": { "$value": { "colorSpace": "srgb", "components": [0.0706, 0.0706, 0.0627], "hex": "#121210" } },
      "darkSurfaceTransparent": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "alpha": 0, "hex": "#0a0a0a" } },
      "darkBorder": { "$value": { "colorSpace": "srgb", "components": [0.1765, 0.1765, 0.1608], "hex": "#2d2d29" } },
      "darkBorderStrong": { "$value": { "colorSpace": "srgb", "components": [0.2667, 0.2667, 0.2431], "hex": "#44443e" } },
      "black08": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" } },
      "black10": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.10, "hex": "#000000" } },
      "black22": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.22, "hex": "#000000" } },
      "black32": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.32, "hex": "#000000" } },
      "blackTransparent": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0, "hex": "#000000" } }
    },
    "light": {
      "$type": "color",
      "ink": { "$value": "{color.palette.ink}" },
      "heading": { "$value": "{color.palette.heading}" },
      "copy": { "$value": "{color.palette.copy}" },
      "muted": { "$value": "{color.palette.muted}" },
      "trait": { "$value": "{color.palette.trait}" },
      "surface": { "$value": "{color.palette.surface}" },
      "surfaceTransparent": { "$value": "{color.palette.surfaceTransparent}" },
      "surfaceRaised": { "$value": "{color.palette.surfaceRaised}" },
      "border": { "$value": "{color.palette.border}" },
      "borderStrong": { "$value": "{color.palette.borderStrong}" }
    },
    "dark": {
      "$type": "color",
      "ink": { "$value": "{color.palette.darkInk}" },
      "heading": { "$value": "{color.palette.white}" },
      "copy": { "$value": "{color.palette.darkCopy}" },
      "muted": { "$value": "{color.palette.darkMuted}" },
      "trait": { "$value": "{color.palette.darkTrait}" },
      "surface": { "$value": "{color.palette.ink}" },
      "surfaceTransparent": { "$value": "{color.palette.darkSurfaceTransparent}" },
      "surfaceRaised": { "$value": "{color.palette.darkSurfaceRaised}" },
      "border": { "$value": "{color.palette.darkBorder}" },
      "borderStrong": { "$value": "{color.palette.darkBorderStrong}" }
    }
  },
  "dimension": {
    "$type": "dimension",
    "contentMaxWidth": { "$value": { "value": 1240, "unit": "px" } },
    "breakpointPhone": { "$value": { "value": 640, "unit": "px" } },
    "breakpointMobile": { "$value": { "value": 767, "unit": "px" } },
    "breakpointTabletMin": { "$value": { "value": 768, "unit": "px" } },
    "breakpointTabletMax": { "$value": { "value": 992, "unit": "px" } },
    "breakpointDesktop": { "$value": { "value": 993, "unit": "px" } },
    "borderHairline": { "$value": { "value": 1, "unit": "px" } },
    "focusRingWidth": { "$value": { "value": 2, "unit": "px" } },
    "focusRingWidthSubtle": { "$value": { "value": 1, "unit": "px" } },
    "focusRingOffset": { "$value": { "value": 3, "unit": "px" } },
    "focusRingOffsetTight": { "$value": { "value": 2, "unit": "px" } },
    "touchTarget": { "$value": { "value": 44, "unit": "px" } },
    "catalogGutter": { "$value": { "value": 32, "unit": "px" } },
    "catalogInlineSpace": { "$value": { "value": 64, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "primary": { "$value": ["SC Acumin", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    }
  },
  "number": {
    "$type": "number",
    "lineHeightModalTitle": { "$value": 1.2 },
    "lineHeightBody": { "$value": 1.52 },
    "lineHeightSubmenu": { "$value": 1.25 },
    "opacityTraitIcon": { "$value": 0.72 },
    "opacityPlaceholder": { "$value": 0.88 },
    "opacityStickyDesktop": { "$value": 0.42 },
    "opacityStickyMobile": { "$value": 0.36 },
    "scalePressed": { "$value": 0.88 },
    "scaleSubmenuPressed": { "$value": 0.985 },
    "productImageWidth": { "$value": 286 },
    "productImageHeight": { "$value": 200 },
    "zRaised": { "$value": 1 },
    "zThemePopover": { "$value": 120 },
    "zModal": { "$value": 9000 }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "zero": { "$value": { "value": 0, "unit": "ms" } },
      "short1": { "$value": { "value": 50, "unit": "ms" } },
      "short2": { "$value": { "value": 100, "unit": "ms" } },
      "short3": { "$value": { "value": 150, "unit": "ms" } },
      "short4": { "$value": { "value": 200, "unit": "ms" } },
      "medium1": { "$value": { "value": 250, "unit": "ms" } },
      "medium2": { "$value": { "value": 300, "unit": "ms" } },
      "medium3": { "$value": { "value": 350, "unit": "ms" } },
      "medium4": { "$value": { "value": 400, "unit": "ms" } },
      "long1": { "$value": { "value": 450, "unit": "ms" } },
      "long2": { "$value": { "value": 500, "unit": "ms" } },
      "long3": { "$value": { "value": 550, "unit": "ms" } },
      "long4": { "$value": { "value": 600, "unit": "ms" } },
      "extraLong1": { "$value": { "value": 700, "unit": "ms" } },
      "extraLong2": { "$value": { "value": 800, "unit": "ms" } },
      "extraLong3": { "$value": { "value": 900, "unit": "ms" } },
      "extraLong4": { "$value": { "value": 1000, "unit": "ms" } },
      "geometryRefreshDelay": { "$value": { "value": 180, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "linear": { "$value": [0, 0, 1, 1] }
    },
    "transition": {
      "$type": "transition",
      "fast": { "$value": { "duration": "{motion.duration.short3}", "delay": "{motion.duration.zero}", "timingFunction": "{motion.easing.decelerate}" } },
      "standard": { "$value": { "duration": "{motion.duration.short3}", "delay": "{motion.duration.zero}", "timingFunction": "{motion.easing.standard}" } },
      "icon": { "$value": { "duration": "{motion.duration.short4}", "delay": "{motion.duration.zero}", "timingFunction": "{motion.easing.decelerate}" } },
      "theme": { "$value": { "duration": "{motion.duration.long3}", "delay": "{motion.duration.zero}", "timingFunction": "{motion.easing.standard}" } }
    },
    "spring": {
      "spatial": {
        "fast": { "stiffness": { "$type": "number", "$value": 1400 }, "damping": { "$type": "number", "$value": 0.9 } },
        "default": { "stiffness": { "$type": "number", "$value": 700 }, "damping": { "$type": "number", "$value": 0.9 } },
        "slow": { "stiffness": { "$type": "number", "$value": 300 }, "damping": { "$type": "number", "$value": 0.9 } }
      },
      "effects": {
        "fast": { "stiffness": { "$type": "number", "$value": 3800 }, "damping": { "$type": "number", "$value": 1 } },
        "default": { "stiffness": { "$type": "number", "$value": 1600 }, "damping": { "$type": "number", "$value": 1 } },
        "slow": { "stiffness": { "$type": "number", "$value": 800 }, "damping": { "$type": "number", "$value": 1 } }
      },
      "indicator": {
        "soft": { "stiffness": { "$type": "number", "$value": 500 }, "damping": { "$type": "number", "$value": 1 } },
        "firm": { "stiffness": { "$type": "number", "$value": 1000 }, "damping": { "$type": "number", "$value": 1 } }
      },
      "focus": { "stiffness": { "$type": "number", "$value": 1500 }, "damping": { "$type": "number", "$value": 1 } }
    }
  },
  "stroke": {
    "$type": "strokeStyle",
    "solid": { "$value": "solid" },
    "dashed": { "$value": "dashed" }
  },
  "border": {
    "light": {
      "$type": "border",
      "default": { "$value": { "color": "{color.light.border}", "width": "{dimension.borderHairline}", "style": "{stroke.solid}" } },
      "strong": { "$value": { "color": "{color.light.borderStrong}", "width": "{dimension.borderHairline}", "style": "{stroke.solid}" } },
      "focus": { "$value": { "color": "{color.light.ink}", "width": "{dimension.focusRingWidth}", "style": "{stroke.solid}" } }
    },
    "dark": {
      "$type": "border",
      "default": { "$value": { "color": "{color.dark.border}", "width": "{dimension.borderHairline}", "style": "{stroke.solid}" } },
      "strong": { "$value": { "color": "{color.dark.borderStrong}", "width": "{dimension.borderHairline}", "style": "{stroke.solid}" } },
      "focus": { "$value": { "color": "{color.dark.ink}", "width": "{dimension.focusRingWidth}", "style": "{stroke.solid}" } }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": { "$value": { "color": "{color.palette.black22}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 18, "unit": "px" }, "blur": { "value": 55, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "submenu": { "$value": { "color": "{color.palette.black08}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "gradient": {
    "$type": "gradient",
    "stickyShadow": { "$value": [
      { "color": "{color.palette.black10}", "position": 0 },
      { "color": "{color.palette.blackTransparent}", "position": 1 }
    ] }
  },
  "typography": {
    "$type": "typography",
    "search": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 15, "unit": "px" }, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.3333333333 } },
    "filter": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 11.25, "unit": "px" }, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.4222222222 } },
    "modalTitle": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 20, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "letterSpacing": { "value": -0.5, "unit": "px" }, "lineHeight": "{number.lineHeightModalTitle}" } },
    "modalBody": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 13.5, "unit": "px" }, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": "{number.lineHeightBody}" } },
    "modalPrice": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 17, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": "{number.lineHeightModalTitle}" } },
    "submenu": { "$value": { "fontFamily": "{font.family.primary}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": "{number.lineHeightSubmenu}" } }
  }
}
