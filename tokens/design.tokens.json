      "extraLarge": { "$value": "{reference.spacing.extraLarge}" },
      "doubleExtraLarge": { "$value": "{reference.spacing.doubleExtraLarge}" },
      "tripleExtraLarge": { "$value": "{reference.spacing.tripleExtraLarge}" },
      "quadExtraLarge": { "$value": "{reference.spacing.quadExtraLarge}" }
    },
    "layout": {
      "$type": "dimension",
      "contentMaxWidth": { "$value": { "value": 1240, "unit": "px" } },
      "breakpointPhone": { "$value": { "value": 640, "unit": "px" } },
      "breakpointMobile": { "$value": { "value": 767, "unit": "px" } },
      "breakpointTabletMin": { "$value": { "value": 768, "unit": "px" } },
      "breakpointTabletMax": { "$value": { "value": 992, "unit": "px" } },
      "breakpointDesktop": { "$value": { "value": 993, "unit": "px" } },
      "breakpointContentNarrow": { "$value": { "value": 1120, "unit": "px" } },
      "gridGutter": {
        "desktop": { "$value": { "value": 28, "unit": "px" } },
        "narrow": { "$value": "{system.spacing.extraLarge}" },
        "compact": { "$value": "{system.spacing.extraLarge}" },
        "mobile": { "$value": { "value": 20, "unit": "px" } }
      }
    },
    "size": {
      "$type": "dimension",
      "touchTarget": { "$value": { "value": 44, "unit": "px" } },
      "icon": { "$value": { "value": 24, "unit": "px" } }
    },
    "stroke": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "focus": { "$value": { "value": 2, "unit": "px" } },
      "focusSubtle": { "$value": { "value": 1, "unit": "px" } },
      "focusOffset": { "$value": { "value": 3, "unit": "px" } },
      "focusOffsetTight": { "$value": { "value": 2, "unit": "px" } }
    },
    "border": {
      "light": {
        "$type": "border",
        "default": { "$value": { "color": "{system.color.light.border}", "width": "{system.stroke.hairline}", "style": "solid" } },
        "strong": { "$value": { "color": "{system.color.light.borderStrong}", "width": "{system.stroke.hairline}", "style": "solid" } },
        "focus": { "$value": { "color": "{system.color.light.focusRing}", "width": "{system.stroke.focus}", "style": "solid" } }
