      "dark": {
        "$type": "border",
        "default": { "$value": { "color": "{system.color.dark.border}", "width": "{system.stroke.hairline}", "style": "solid" } },
        "strong": { "$value": { "color": "{system.color.dark.borderStrong}", "width": "{system.stroke.hairline}", "style": "solid" } },
        "focus": { "$value": { "color": "{system.color.dark.focusRing}", "width": "{system.stroke.focus}", "style": "solid" } }
      }
    },
    "elevation": {
      "$type": "shadow",
      "menu": { "$value": { "color": "{reference.color.shadowMenu}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
      "popover": { "$value": { "color": "{reference.color.shadowPopover}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
      "dialog": { "$value": { "color": "{reference.color.shadowDialog}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 18, "unit": "px" }, "blur": { "value": 55, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
    },
    "state": {
      "opacity": {
        "$type": "number",
        "disabled": { "$value": 0.38 },
        "muted": { "$value": 0.78 },
        "placeholder": { "$value": 0.88 }
      }
    },
    "layer": {
      "$type": "number",
      "raised": { "$value": 1 },
      "sticky": { "$value": 120 },
      "popover": { "$value": 120 },
      "mobileMenu": { "$value": 1000 },
      "mobilePanel": { "$value": 1001 },
      "modal": { "$value": 9000 }
    },
    "media": {
      "aspectRatio": {
        "$type": "number",
        "product": { "$value": 1.43 }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "short1": { "$value": "{reference.duration.short1}" },
        "short2": { "$value": "{reference.duration.short2}" },
        "short3": { "$value": "{reference.duration.short3}" },
        "short4": { "$value": "{reference.duration.short4}" },
        "medium1": { "$value": "{reference.duration.medium1}" },
        "medium2": { "$value": "{reference.duration.medium2}" },
        "medium3": { "$value": "{reference.duration.medium3}" },
        "medium4": { "$value": "{reference.duration.medium4}" },
        "long1": { "$value": "{reference.duration.long1}" },
        "long2": { "$value": "{reference.duration.long2}" },
        "long3": { "$value": "{reference.duration.long3}" },
        "long4": { "$value": "{reference.duration.long4}" },
        "extraLong1": { "$value": "{reference.duration.extraLong1}" },
        "extraLong2": { "$value": "{reference.duration.extraLong2}" },
        "extraLong3": { "$value": "{reference.duration.extraLong3}" },
        "extraLong4": { "$value": "{reference.duration.extraLong4}" }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": "{reference.easing.standard}" },
        "accelerate": { "$value": "{reference.easing.accelerate}" },
        "decelerate": { "$value": "{reference.easing.decelerate}" },
        "linear": { "$value": "{reference.easing.linear}" }
      },
      "transition": {
        "$type": "transition",
        "fast": { "$value": { "duration": "{system.motion.duration.short3}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{system.motion.easing.decelerate}" } },
        "standard": { "$value": { "duration": "{system.motion.duration.short3}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{system.motion.easing.standard}" } },
        "icon": { "$value": { "duration": "{system.motion.duration.short4}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{system.motion.easing.decelerate}" } },
        "theme": { "$value": { "duration": "{system.motion.duration.long3}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{system.motion.easing.standard}" } }
      },
      "spring": {
        "$type": "number",
        "spatial": {
          "fast": { "stiffness": { "$value": "{reference.spring.spatial.fast.stiffness}" }, "damping": { "$value": "{reference.spring.spatial.fast.damping}" } },
          "default": { "stiffness": { "$value": "{reference.spring.spatial.default.stiffness}" }, "damping": { "$value": "{reference.spring.spatial.default.damping}" } },
          "slow": { "stiffness": { "$value": "{reference.spring.spatial.slow.stiffness}" }, "damping": { "$value": "{reference.spring.spatial.slow.damping}" } }
        },
        "effects": {
          "fast": { "stiffness": { "$value": "{reference.spring.effects.fast.stiffness}" }, "damping": { "$value": "{reference.spring.effects.fast.damping}" } },
          "default": { "stiffness": { "$value": "{reference.spring.effects.default.stiffness}" }, "damping": { "$value": "{reference.spring.effects.default.damping}" } },
          "slow": { "stiffness": { "$value": "{reference.spring.effects.slow.stiffness}" }, "damping": { "$value": "{reference.spring.effects.slow.damping}" } }
        },
        "indicator": {
          "soft": { "stiffness": { "$value": "{reference.spring.indicator.soft.stiffness}" }, "damping": { "$value": "{reference.spring.indicator.soft.damping}" } },
          "firm": { "stiffness": { "$value": "{reference.spring.indicator.firm.stiffness}" }, "damping": { "$value": "{reference.spring.indicator.firm.damping}" } }
        },
        "focus": { "stiffness": { "$value": "{reference.spring.focus.stiffness}" }, "damping": { "$value": "{reference.spring.focus.damping}" } }
      }
    }
  }
}
