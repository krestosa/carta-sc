{
  "$description": "Canonical reusable design language for SushiClub web interfaces. Reference values feed a semantic system API consumed by CSS and TypeScript.",
  "reference": {
    "$description": "Foundational values. Application code does not consume this group directly.",
    "color": {
      "$type": "color",
      "ink": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392] } },
      "heading": { "$value": { "colorSpace": "srgb", "components": [0.1882, 0.1882, 0.1882] } },
      "copy": { "$value": { "colorSpace": "srgb", "components": [0.3725, 0.3725, 0.3725] } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.4627, 0.4627, 0.4627] } },
      "trait": { "$value": { "colorSpace": "srgb", "components": [0.5961, 0.5961, 0.5961] } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9608] } },
      "surfaceTransparent": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9608], "alpha": 0 } },
      "surfaceRaised": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9843, 0.9804] } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8902, 0.8706] } },
      "borderStrong": { "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8196, 0.7961] } },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
      "darkInk": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9529, 0.9412] } },
      "darkCopy": { "$value": { "colorSpace": "srgb", "components": [0.7843, 0.7843, 0.7608] } },
      "darkMuted": { "$value": { "colorSpace": "srgb", "components": [0.6118, 0.6118, 0.5843] } },
      "darkTrait": { "$value": { "colorSpace": "srgb", "components": [0.4353, 0.4353, 0.4353] } },
      "darkSurface": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } },
      "darkSurfaceRaised": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392] } },
      "darkSurfaceTransparent": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 } },
      "darkBorder": { "$value": { "colorSpace": "srgb", "components": [0.1765, 0.1765, 0.1608] } },
      "darkBorderStrong": { "$value": { "colorSpace": "srgb", "components": [0.2667, 0.2667, 0.2431] } },
      "scrim": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.32 } },
      "shadowMenu": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08 } },
      "shadowPopover": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.09 } },
      "shadowDialog": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.22 } }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "primary": { "$value": ["SC Acumin", "Arial", "sans-serif"] }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    },
    "shape": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "px" } },
      "extraSmall": { "$value": { "value": 1, "unit": "px" } },
      "small": { "$value": { "value": 2, "unit": "px" } },
      "medium": { "$value": { "value": 4, "unit": "px" } },
      "large": { "$value": { "value": 16, "unit": "px" } },
      "extraLarge": { "$value": { "value": 28, "unit": "px" } },
      "full": { "$value": { "value": 9999, "unit": "px" } }
    },
    "spacing": {
      "$type": "dimension",
      "extraSmall": { "$value": { "value": 4, "unit": "px" } },
      "small": { "$value": { "value": 8, "unit": "px" } },
      "medium": { "$value": { "value": 12, "unit": "px" } },
      "large": { "$value": { "value": 16, "unit": "px" } },
      "extraLarge": { "$value": { "value": 24, "unit": "px" } },
      "doubleExtraLarge": { "$value": { "value": 32, "unit": "px" } },
      "tripleExtraLarge": { "$value": { "value": 48, "unit": "px" } },
      "quadExtraLarge": { "$value": { "value": 64, "unit": "px" } }
    },
    "duration": {
      "$type": "duration",
      "short1": { "$value": { "value": 50, "unit": "ms" } },
      "short2": { "$value": { "value": 100, "unit": "ms" } },
      "short3": { "$value": { "value": 150, "unit": "ms" } },
      "short4": { "$value": { "value": 200, "unit": "ms" } },
      "medium1": { "$value": { "value": 250, "unit": "ms" } },
      "medium2": { "$value": { "value": 300, "unit": "ms" } },
      "medium3": { "$value": { "value": 350, "unit": "ms" } },
      "medium4": { "$value": { "value": 400, "unit": "ms" } },
      "long1": { "$value": { "value": 450, "unit": "ms" } },
      "long2": { "$value": { "value": 500, "unit": "ms" } },
      "long3": { "$value": { "value": 550, "unit": "ms" } },
      "long4": { "$value": { "value": 600, "unit": "ms" } },
      "extraLong1": { "$value": { "value": 700, "unit": "ms" } },
      "extraLong2": { "$value": { "value": 800, "unit": "ms" } },
      "extraLong3": { "$value": { "value": 900, "unit": "ms" } },
      "extraLong4": { "$value": { "value": 1000, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "linear": { "$value": [0, 0, 1, 1] }
    },
    "spring": {
      "$type": "number",
      "spatial": {
        "fast": { "stiffness": { "$value": 1400 }, "damping": { "$value": 0.9 } },
        "default": { "stiffness": { "$value": 700 }, "damping": { "$value": 0.9 } },
        "slow": { "stiffness": { "$value": 300 }, "damping": { "$value": 0.9 } }
      },
      "effects": {
        "fast": { "stiffness": { "$value": 3800 }, "damping": { "$value": 1 } },
        "default": { "stiffness": { "$value": 1600 }, "damping": { "$value": 1 } },
        "slow": { "stiffness": { "$value": 800 }, "damping": { "$value": 1 } }
      },
      "indicator": {
        "soft": { "stiffness": { "$value": 500 }, "damping": { "$value": 1 } },
        "firm": { "stiffness": { "$value": 1000 }, "damping": { "$value": 1 } }
      },
      "focus": { "stiffness": { "$value": 1500 }, "damping": { "$value": 1 } }
    }
  },
  "system": {
    "$description": "Public semantic design-system API. CSS and TypeScript consume this group, never reference values directly.",
    "color": {
      "light": {
        "$type": "color",
        "ink": { "$value": "{reference.color.ink}" },
        "heading": { "$value": "{reference.color.heading}" },
        "copy": { "$value": "{reference.color.copy}" },
        "muted": { "$value": "{reference.color.muted}" },
        "trait": { "$value": "{reference.color.trait}" },
        "surface": { "$value": "{reference.color.surface}" },
        "surfaceTransparent": { "$value": "{reference.color.surfaceTransparent}" },
        "surfaceRaised": { "$value": "{reference.color.surfaceRaised}" },
        "border": { "$value": "{reference.color.border}" },
        "borderStrong": { "$value": "{reference.color.borderStrong}" },
        "focusRing": { "$value": "{reference.color.ink}" }
      },
      "dark": {
        "$type": "color",
        "ink": { "$value": "{reference.color.darkInk}" },
        "heading": { "$value": "{reference.color.white}" },
        "copy": { "$value": "{reference.color.darkCopy}" },
        "muted": { "$value": "{reference.color.darkMuted}" },
        "trait": { "$value": "{reference.color.darkTrait}" },
        "surface": { "$value": "{reference.color.darkSurface}" },
        "surfaceTransparent": { "$value": "{reference.color.darkSurfaceTransparent}" },
        "surfaceRaised": { "$value": "{reference.color.darkSurfaceRaised}" },
        "border": { "$value": "{reference.color.darkBorder}" },
        "borderStrong": { "$value": "{reference.color.darkBorderStrong}" },
        "focusRing": { "$value": "{reference.color.darkInk}" }
      },
      "scrim": { "$type": "color", "$value": "{reference.color.scrim}" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "primary": { "$value": "{reference.fontFamily.primary}" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": "{reference.fontWeight.regular}" },
      "semibold": { "$value": "{reference.fontWeight.semibold}" }
    },
    "typography": {
      "$description": "Reusable type roles. Semantic HTML chooses the appropriate role instead of coupling visual hierarchy to tag names.",
      "heading1": {
        "desktop": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 28, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -1.12, "unit": "px" }, "lineHeight": 1.08 } },
        "tablet": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 22, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.704, "unit": "px" }, "lineHeight": 1.08 } },
        "mobile": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 20, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.64, "unit": "px" }, "lineHeight": 1.08 } }
      },
      "heading2": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 20, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.5, "unit": "px" }, "lineHeight": 1.2 } },
      "heading3": {
        "desktop": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 18.5, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.4625, "unit": "px" }, "lineHeight": 1.15 } },
        "tablet": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 16, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.288, "unit": "px" }, "lineHeight": 1.16 } },
        "mobile": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 15.5, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.279, "unit": "px" }, "lineHeight": 1.16 } }
      },
      "heading4": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 15.5, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.2325, "unit": "px" }, "lineHeight": 1.26 } },
      "bodyLarge": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 15, "unit": "px" }, "fontWeight": "{system.fontWeight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.3333333333 } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 13.5, "unit": "px" }, "fontWeight": "{system.fontWeight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.52 } },
      "bodySmall": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 12.5, "unit": "px" }, "fontWeight": "{system.fontWeight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.28 } },
      "label": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": "{system.fontWeight.regular}", "letterSpacing": { "value": -0.06, "unit": "px" }, "lineHeight": 1.2 } },
      "labelStrong": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 14, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } },
      "price": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 15.5, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": -0.279, "unit": "px" }, "lineHeight": 1.1612903226 } },
      "priceLarge": { "$type": "typography", "$value": { "fontFamily": "{system.fontFamily.primary}", "fontSize": { "value": 17, "unit": "px" }, "fontWeight": "{system.fontWeight.semibold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } }
    },
    "shape": {
      "$type": "dimension",
      "none": { "$value": "{reference.shape.none}" },
      "extraSmall": { "$value": "{reference.shape.extraSmall}" },
      "menu": { "$value": "{reference.shape.small}" },
      "control": { "$value": "{reference.shape.medium}" },
      "card": { "$value": "{reference.shape.large}" },
      "dialog": { "$value": "{reference.shape.extraLarge}" },
      "button": { "$value": "{reference.shape.full}" },
      "full": { "$value": "{reference.shape.full}" }
    },
    "spacing": {
      "$type": "dimension",
      "extraSmall": { "$value": "{reference.spacing.extraSmall}" },
      "small": { "$value": "{reference.spacing.small}" },
      "medium": { "$value": "{reference.spacing.medium}" },
